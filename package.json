{
  "name": "diveo",
  "version": "1.0.19",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint app features shared services utils scripts vitest.config.mjs --max-warnings 0",
    "stack:env": "node scripts/generate-stack-env.js",
    "stack:env:check": "node scripts/generate-stack-env.js --check",
    "stack:receipt": "node scripts/stack-architecture-receipt.js --require-assets --output docs/qa-evidence/local-stack-architecture-receipt.json",
    "stack:receipt:check": "node scripts/stack-architecture-receipt.js --require-assets --verify docs/qa-evidence/local-stack-architecture-receipt.json",
    "stack:seed-assets": "node scripts/seed-stack-assets.js",
    "dev:stack": "node scripts/dev-stack.js",
    "dev:doctor": "node scripts/dev-doctor.js",
    "dev:stop": "node scripts/dev-stop.js",
    "verify:local": "node scripts/run-verification-bundle.js local",
    "verify:release-candidate": "node scripts/run-verification-bundle.js release-candidate",
    "vendor:gsav": "node scripts/vendor-gsav-packages.mjs",
    "gsav:preflight": "node scripts/gsav-native-preflight.js",
    "gsav:runtime-smoke": "node scripts/gsav-native-runtime-smoke.js",
    "android:installed-smoke": "node scripts/capture-android-installed-smoke.js",
    "android:version-metadata": "node scripts/capture-android-version-metadata.js",
    "device-evidence:packet": "node scripts/device-evidence-packet.js",
    "release-evidence:attach-validation-prereqs": "node scripts/attach-validation-prereqs-to-release-evidence.js",
    "release-evidence:branch-protection": "node scripts/capture-branch-protection-evidence.js",
    "release-evidence:github-release-state": "node scripts/capture-github-release-state-evidence.js",
    "release-evidence:publish-hash-guard": "node scripts/capture-publish-hash-variable-guard.js",
    "external-evidence:scaffold": "node scripts/verify-external-evidence-inventory.js --scaffold",
    "verify:docs-drift": "node scripts/verify-doc-drift.js",
    "verify:workflows": "node scripts/verify-workflows.js",
    "verify:whitespace": "node scripts/verify-whitespace.js",
    "verify:import-boundaries": "node scripts/verify-import-boundaries.js",
    "verify:bridge-origin-contract": "node scripts/verify-bridge-origin-contract.js",
    "verify:shared-catalog-contract": "node scripts/verify-shared-catalog-contract.js",
    "verify:dependency-audit": "node scripts/verify-dependency-audit.js",
    "verify:env-examples": "node scripts/verify-env-examples.js",
    "verify:handoff-receipts": "node scripts/verify-handoff-receipts.js",
    "verify:validation-prereqs": "node scripts/verify-validation-prereqs.js",
    "verify:native-production-config": "node scripts/verify-native-production-config.js",
    "verify:no-publish-baseline": "node scripts/verify-no-publish-baseline.js",
    "verify:release-artifact": "node scripts/verify-release-artifact.js",
    "verify:release-evidence-bundle": "node scripts/verify-release-evidence-bundle.js",
    "verify:external-evidence-inventory": "node scripts/verify-external-evidence-inventory.js",
    "verify:final-readiness-receipts": "node scripts/run-final-readiness-receipts.js",
    "verify:release-readiness": "node scripts/verify-release-readiness.js"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@opsiclear/gsav-bridge": "file:vendor/opsiclear-gsav-bridge-0.1.0.tgz",
    "@opsiclear/gsav-client": "file:vendor/opsiclear-gsav-client-0.2.0.tgz",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~55.0.5",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.11",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-intent-launcher": "~55.0.9",
    "expo-router": "~55.0.4",
    "expo-screen-orientation": "~55.0.8",
    "expo-secure-store": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "private": true
}
